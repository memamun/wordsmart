rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User progress and profile for global leaderboard & cloud sync
    match /users/{userId} {
      // Leaderboard requires reading top users
      allow read: if true;
      
      // Only authenticated users can write their own record
      allow create, update: if request.auth != null 
                            && request.auth.uid == userId
                            && request.resource.data.uid == userId
                            && request.resource.data.xp is number
                            && request.resource.data.level is number
                            && request.resource.data.streak is number;
      
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
